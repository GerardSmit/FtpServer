{
  "Port": 21,
  "Path": "ftproot",
  "Passive": true,
  "FollowLinks": false,
  "Ftps": false,
  "RequireTls": false,
  "ReadOnly": false,

  "Authentication": {
    "AllowAnonymous": false,
    "AnonymousCanWrite": false,
    "MaxFailedAttempts": 5,
    "Users": []
  },

  "Connection": {
    "MaxConnections": 100,
    "MaxConnectionsPerAddress": 10,
    "MaxCommandLength": 4096,
    "IdleTimeout": "00:05:00"
  },

  "DataConnection": {
    "AllowForeignHost": false,
    "MinimumPort": 1024,
    "VerifyPeerAddress": true,
    "PublicAddress": null,
    "Timeout": "00:00:30"
  },

  "Certificate": {
    "Path": null,
    "Password": null,
    "SelfSignedSubject": "localhost",
    "AllowTlsResume": true
  },

  "PassivePortRange": {
    "Start": 50000,
    "End": 50100
  },

  "Features": {
    "XCRC": true,
    "LISTR": true,
    "MLST": true,
    "Hash": true,
    "Site": true,
    "IgnoreUnsupportedChmod": true
  },

  "List": {
    "RecursionLimit": 10,
    "MaxEntries": 100000
  }
}
