<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>FtpServer</RootNamespace>
        <IsAotCompatible>true</IsAotCompatible>
        <IsPackable>true</IsPackable>
        <PackageId>GerardSmit.FtpServer.Sockets</PackageId>
        <Description>Raw-socket hosting for GerardSmit.FtpServer.Core, as an IHostedService.</Description>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.0" />
        <PackageReference Include="Pipelines.Sockets.Unofficial" Version="2.2.8" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\FtpServer.Core\FtpServer.Core.csproj" />
    </ItemGroup>

</Project>
